# ===== 模型池网关 环境变量示例 =====
# 复制为 .env 后填写；所有变量均有默认值，可仅按需覆盖。

# 数据库（SQLite 默认；可换 Postgres：postgresql+psycopg://user:pass@host:5432/db）
LLM_POOL_DB_URL=sqlite:///./llm_pool.db

# 管理后台账号（务必在生产环境修改）
LLM_POOL_ADMIN_USER=admin
LLM_POOL_ADMIN_PASS=admin123

# 管理 token 签名密钥
# 留空 = 自动生成随机密钥并持久化于 .llm_pool_secret（推荐，重启复用）
# 多实例需共享同一密钥时，显式设置一个随机长字符串
LLM_POOL_SECRET=

# 跨域允许来源（逗号分隔；默认 *；管理台同源部署一般无需改）
LLM_POOL_CORS_ORIGINS=*

# 网关 key（业务客户端调用 /v1/* 使用，逗号分隔可配置多个）
LLM_POOL_GATEWAY_KEYS=gpk-default

# 种子文件（首次启动空库时导入平台/模型/额度包）
LLM_POOL_AUTO_SEED=1
LLM_POOL_SEED_FILE=backend/seed.yaml

# 执行器：设为 1 强制走 Mock（不真实调用厂商，用于演示/测试）；删除或 0 走真实 LiteLLM
LLM_POOL_FORCE_MOCK=

# 兜底（escape）模型 id：当所有候选模型不可用 / 余额耗尽时，路由到此模型
# 该模型在 seed.yaml 中定义为无额度包、始终可用
LLM_POOL_ESCAPE_MODEL_ID=escape

# 服务监听
LLM_POOL_HOST=0.0.0.0
LLM_POOL_PORT=8000
